# Entity: enumeration

main: kit: entity: enumeration: {

  alias: field: {}

  fields: [
    {
      name: "iso2"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "enumeration"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/enumeration/basic"
          parts: [
            "enumeration"
            "basic"
          ]
          select: {
            "$action": "basic"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/enumeration/country"
          parts: [
            "enumeration"
            "country"
          ]
          select: {
            "$action": "country"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/enumeration/license"
          parts: [
            "enumeration"
            "license"
          ]
          select: {
            "$action": "license"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "enumeration"
                orig: "enumeration"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/enumeration/basic/{enumeration}"
          parts: [
            "enumeration"
            "basic"
            "{enumeration}"
          ]
          select: {
            exist: [
              "enumeration"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "basic"
      ]
    ]
  }



}
