# Entity: species

main: kit: entity: species: {

  alias: field: {}

  fields: [
    {
      name: "canonicalName"
      req: false
      type: "`$STRING`"
    }
    {
      name: "confidence"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "key"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "matchType"
      req: false
      type: "`$STRING`"
    }
    {
      name: "rank"
      req: false
      type: "`$STRING`"
    }
    {
      name: "scientificName"
      req: false
      type: "`$STRING`"
    }
    {
      name: "usageKey"
      req: false
      type: "`$INTEGER`"
    }
  ]

  name: "species"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 20
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 0
                kind: "query"
                name: "offset"
                orig: "offset"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "q"
                orig: "q"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/species/search"
          parts: [
            "species"
            "search"
          ]
          select: {
            "$action": "search"
            exist: [
              "limit"
              "offset"
              "q"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "kingdom"
                orig: "kingdom"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "name"
                orig: "name"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/species/match"
          parts: [
            "species"
            "match"
          ]
          select: {
            "$action": "match"
            exist: [
              "kingdom"
              "name"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
